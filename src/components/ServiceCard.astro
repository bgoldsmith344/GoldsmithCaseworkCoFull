---
interface Props {
  slug: string;
  title: string;
  summary: string;
  specTag: string;
}
const { slug, title, summary, specTag } = Astro.props;
---

<a
  href={`/services/${slug}/`}
  class="group flex flex-col gap-3 border border-ink/15 bg-paper p-6 transition-colors hover:border-blueline"
>
  <span class="spec-tag">{specTag}</span>
  <h3 class="font-display text-lg font-extrabold">{title}</h3>
  <p class="text-sm text-ink/75">{summary}</p>
  <span class="mt-auto pt-2 font-mono text-xs font-medium text-blueline-ink group-hover:underline">
    View service &rarr;
  </span>
</a>
