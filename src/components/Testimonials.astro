---
import { testimonials } from '../content/site.ts';
// Renders nothing until testimonials exist — easy to fill in site.ts later.
---
{
  testimonials.length > 0 && (
    <section class="section section--paper">
      <div class="container">
        <p class="eyebrow">What shops say</p>
        <h2>Trusted by the shops we work with</h2>
        <div class="grid grid--2" style="margin-top: var(--space-4)">
          {testimonials.map((t) => (
            <blockquote class="quote card reveal">
              <p>“{t.quote}”</p>
              <footer>
                <strong>{t.author}</strong>
                {t.company && <span>, {t.company}</span>}
              </footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .quote p { font-size: var(--fs-lead); color: var(--ink-soft); }
  .quote footer { margin-top: var(--space-2); color: var(--muted); }
  .quote strong { color: var(--ink); font-family: var(--font-head); }
</style>
