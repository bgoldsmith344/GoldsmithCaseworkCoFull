---
import { withBase } from "@/lib/url";

interface Props {
  items: { name: string; path: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mx-auto max-w-6xl px-6 pt-6">
  <ol class="flex flex-wrap items-center gap-2 font-mono text-xs uppercase tracking-wide text-ink/60">
    {items.map((item, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i === items.length - 1 ? (
          <span aria-current="page" class="text-ink">{item.name}</span>
        ) : (
          <a href={withBase(item.path)} class="hover:text-blueline-ink">{item.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
