---
import { credentials } from '../content/site.ts';
// Renders nothing until credentials exist.
---
{
  credentials.length > 0 && (
    <ul class="creds">
      {credentials.map((c) => (
        <li class="creds__item">
          <strong>{c.label}</strong>
          {c.detail && <span>{c.detail}</span>}
        </li>
      ))}
    </ul>
  )
}

<style>
  .creds {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .creds__item {
    display: flex;
    flex-direction: column;
    padding: var(--space-2) var(--space-3);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }
  .creds__item strong { font-family: var(--font-head); color: var(--ink); }
  .creds__item span { color: var(--muted); font-size: var(--fs-small); }
</style>
