---
import Button from './Button.astro';
interface Props {
  title: string;
  label: string;
  href: string;
  text?: string;
}
const { title, label, href, text } = Astro.props;
---
<section class="section section--ink">
  <div class="container narrow cta-band">
    <h2>{title}</h2>
    {text && <p class="lead">{text}</p>}
    <Button href={href} variant="primary">{label}</Button>
  </div>
</section>

<style>
  .cta-band {
    text-align: center;
    display: grid;
    gap: var(--space-3);
    justify-items: center;
  }
</style>
