---
const steps = [
  {
    n: "01",
    title: "Send your drawings",
    body: "Architect's plans, a sketch, a DXF, or a photo of a napkin.",
  },
  {
    n: "02",
    title: "We draft it",
    body: "A dimensioned shop drawing comes back for your approval.",
  },
  {
    n: "03",
    title: "Material sourced",
    body: "We buy it, or you drop it off — either works.",
  },
  {
    n: "04",
    title: "Cut and ready",
    body: "Parts finished to the approved drawing, on your schedule.",
  },
];
---

<ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
  {steps.map((step) => (
    <li class="flex flex-col gap-2">
      <span class="font-mono text-sm text-blueline-ink">{step.n}</span>
      <h3 class="font-display text-base font-extrabold">{step.title}</h3>
      <p class="text-sm text-ink/75">{step.body}</p>
    </li>
  ))}
</ol>
