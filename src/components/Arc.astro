---
// The signature element: a dimensioned arc rendered like a page out of a shop
// drawing set — extension lines, a radius callout, a dashed centerline. Draws
// in once on load; fully rendered immediately under prefers-reduced-motion.
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg
  viewBox="0 0 640 360"
  role="img"
  aria-label="Dimensioned drawing of an arched radius component, callout reading R 48 inches"
  class={`arc-drawing w-full ${className}`}
  fill="none"
>
  <defs>
    <marker id="arrow-end" markerWidth="10" markerHeight="10" refX="8" refY="4" orient="auto">
      <path d="M0,0 L8,4 L0,8 Z" fill="var(--color-blueline)" />
    </marker>
    <marker id="arrow-start" markerWidth="10" markerHeight="10" refX="2" refY="4" orient="auto">
      <path d="M8,0 L0,4 L8,8 Z" fill="var(--color-blueline)" />
    </marker>
  </defs>

  <!-- centerline -->
  <line x1="320" y1="16" x2="320" y2="344" stroke="var(--color-blueline)" stroke-opacity="0.45" stroke-width="1" stroke-dasharray="20 6 2 6" class="arc-fade" style="animation-delay: 640ms" />

  <!-- baseline / springline -->
  <line x1="72" y1="300" x2="568" y2="300" stroke="var(--color-blueline)" stroke-opacity="0.35" stroke-width="1" stroke-dasharray="4 5" class="arc-fade" style="animation-delay: 560ms" />

  <!-- extension ticks at the arc's springpoints -->
  <line x1="80" y1="316" x2="80" y2="284" stroke="var(--color-blueline)" stroke-opacity="0.6" stroke-width="1.5" class="arc-fade" style="animation-delay: 460ms" />
  <line x1="560" y1="316" x2="560" y2="284" stroke="var(--color-blueline)" stroke-opacity="0.6" stroke-width="1.5" class="arc-fade" style="animation-delay: 460ms" />

  <!-- the arc itself -->
  <path
    d="M80,300 C80,150 180,64 320,64 C460,64 560,150 560,300"
    stroke="var(--color-blueline)"
    stroke-width="4"
    stroke-linecap="round"
    class="arc-draw"
  />

  <!-- radius dimension line, center point to arc crown -->
  <circle cx="320" cy="300" r="3" fill="var(--color-blueline)" class="arc-fade" style="animation-delay: 720ms" />
  <line
    x1="320" y1="296" x2="320" y2="72"
    stroke="var(--color-blueline)"
    stroke-width="1.25"
    stroke-dasharray="6 4"
    marker-end="url(#arrow-end)"
    class="arc-fade"
    style="animation-delay: 720ms"
  />

  <text x="336" y="190" class="radius-label arc-fade" style="animation-delay: 900ms">R 48&quot;</text>
</svg>

<style>
  .arc-drawing text.radius-label {
    font-family: var(--font-mono);
    font-size: 15px;
    fill: var(--color-blueline);
  }

  .arc-draw {
    stroke-dasharray: 1400;
    stroke-dashoffset: 1400;
    animation: draw-arc 900ms ease-out forwards;
  }

  .arc-fade {
    opacity: 0;
    animation: fade-in 500ms ease-out forwards;
  }

  @keyframes draw-arc {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes fade-in {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arc-draw {
      animation: none;
      stroke-dashoffset: 0;
    }
    .arc-fade {
      animation: none;
      opacity: 1;
    }
  }
</style>
