---
import Placeholder from './Placeholder.astro';
interface Props {
  title: string;
  category: string;
  image: string;
  alt: string;
  caption?: string;
}
const { title, category, image, alt, caption } = Astro.props;
---
<figure class="work-card reveal">
  <div class="work-card__media">
    <Placeholder src={image} alt={alt} label={`${category} sample`} ratio="4 / 3" />
    <span class="work-card__tag">{category}</span>
  </div>
  <figcaption class="work-card__cap">
    <h3>{title}</h3>
    {caption && <p>{caption}</p>}
  </figcaption>
</figure>

<style>
  .work-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .work-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }
  .work-card__media { position: relative; }
  .work-card__media :global(.ph),
  .work-card__media :global(.ph__img) { border-radius: 0; }
  .work-card__tag {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: var(--ink);
    color: #fff;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
  }
  .work-card__cap {
    padding: var(--space-3);
  }
  .work-card__cap h3 { font-size: 1.1rem; margin-bottom: 0.3rem; }
  .work-card__cap p { font-size: var(--fs-small); color: var(--muted); }
</style>
