---
import Icon from './Icon.astro';
interface Props {
  items: readonly string[];
}
const { items } = Astro.props;
---
<ul class="checklist">
  {
    items.map((item) => (
      <li class="checklist__item">
        <span class="checklist__mark"><Icon name="check" size={18} /></span>
        <span>{item}</span>
      </li>
    ))
  }
</ul>

<style>
  .checklist {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  @media (min-width: 640px) {
    .checklist { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 980px) {
    .checklist { grid-template-columns: repeat(3, 1fr); }
  }
  .checklist__item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-head);
    font-weight: 500;
    color: var(--ink);
  }
  .checklist__mark {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--brass-tint);
    color: var(--brass-dark);
  }
</style>
