---
import { site } from "@/config/site";
import { primaryNav, legalNav } from "@/lib/nav";
import PhoneLink from "@/components/PhoneLink.astro";
import { isDev } from "@/lib/placeholder";
import { withBase } from "@/lib/url";
---

<footer class="border-t border-ink/10 bg-spruce text-paper">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="grid gap-10 md:grid-cols-4">
      <div>
        <p class="font-display text-lg font-extrabold">{site.displayName}</p>
        <p class="mt-2 max-w-xs text-sm text-paper/75">{site.tagline}</p>
      </div>

      <div>
        <p class="spec-tag text-paper/60">Contact</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><PhoneLink class="text-paper" /></li>
          {site.email ? (
            <li><a href={`mailto:${site.email}`} class="hover:underline">{site.email}</a></li>
          ) : isDev ? (
            <li class="text-amber">[TODO: email]</li>
          ) : null}
          <li>{site.address.city}, {site.address.state}</li>
        </ul>
      </div>

      <div>
        <p class="spec-tag text-paper/60">Site</p>
        <ul class="mt-3 space-y-2 text-sm">
          {primaryNav.map((item) => (
            <li><a href={withBase(item.href)} class="hover:underline">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <p class="spec-tag text-paper/60">Serving Northern Michigan</p>
        <p class="mt-3 text-sm text-paper/75">
          {site.serviceArea.join(" · ")}
        </p>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-3 border-t border-paper/15 pt-6 text-xs text-paper/60 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {new Date().getFullYear()} {site.legalName ?? site.displayName}. All rights reserved.</p>
      <div class="flex gap-4">
        {legalNav.map((item) => (
          <a href={withBase(item.href)} class="hover:underline">{item.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
