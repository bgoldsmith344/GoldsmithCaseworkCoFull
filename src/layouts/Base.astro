---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Seo from "@/components/Seo.astro";
import "@/styles/global.css";
// @ts-expect-error — Fontsource ships no types for its raw font-file exports
import archivoDisplayWoff2 from "@fontsource/archivo/files/archivo-latin-800-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: object[];
}

const { title, description, path, jsonLd = [] } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1b3a31" />
    <link rel="preload" href={archivoDisplayWoff2} as="font" type="font/woff2" crossorigin />
    <Seo title={title} description={description} path={path} jsonLd={jsonLd} />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-paper font-body text-ink antialiased">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
