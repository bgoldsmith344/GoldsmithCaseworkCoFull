---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { site } from '../content/site.ts';
---
<Base title="Thank You" description="Your request has been received.">
  <section class="section">
    <div class="container narrow stack thanks" style="text-align:center; display:grid; justify-items:center;">
      <p class="eyebrow">Request received</p>
      <h1>Thanks — we'll be in touch.</h1>
      <p class="lead">{site.contact.responseTime} In the meantime, feel free to email us directly at <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.</p>
      <Button href="/" variant="secondary">Back to home</Button>
    </div>
  </section>
</Base>
