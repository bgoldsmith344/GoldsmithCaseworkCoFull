---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { site } from "@/config/site";
import { breadcrumbSchema } from "@/lib/schema";

const crumbs = [{ name: "Home", path: "/" }, { name: "Privacy", path: "/privacy/" }];
---

<Base
  title="Privacy Policy | Goldsmith Casework"
  description="How Goldsmith Casework handles information submitted through this website."
  path="/privacy/"
  jsonLd={[breadcrumbSchema(crumbs)]}
>
  <Breadcrumbs items={crumbs} />

  <section class="mx-auto max-w-3xl px-6 py-12">
    <h1 class="font-display text-h1 font-extrabold">Privacy Policy</h1>
    <p class="mt-3 font-mono text-xs text-ink/50">Last updated: placeholder — review before launch</p>

    <div class="mt-8 space-y-6 text-ink/80">
      <p>
        This page explains, in plain language, what happens with the information you submit through this
        website's forms. It is placeholder legal copy and should be reviewed before the site goes live.
      </p>

      <div>
        <h2 class="font-display text-h3 font-extrabold">What we collect</h2>
        <p class="mt-2">
          The Quote and Contact forms collect the information you enter — name, company, phone, email,
          project details, and any files you attach — along with how you say you found us, if you tell us.
          We don't use analytics or advertising trackers on this site.
        </p>
      </div>

      <div>
        <h2 class="font-display text-h3 font-extrabold">How it's used</h2>
        <p class="mt-2">
          Submissions are used to respond to your inquiry and quote your project. We don't sell or share
          your information with third parties for marketing purposes.
        </p>
      </div>

      <div>
        <h2 class="font-display text-h3 font-extrabold">Third-party form processing</h2>
        <p class="mt-2">
          Form submissions are delivered through a third-party form service. That service processes the
          data to deliver it to us; it isn't used for anything beyond that delivery.
        </p>
      </div>

      <div>
        <h2 class="font-display text-h3 font-extrabold">Contact</h2>
        <p class="mt-2">
          Questions about this policy or a request to have your information removed can go to
          {site.email ? (
            <a href={`mailto:${site.email}`} class="text-blueline-ink hover:underline">{site.email}</a>
          ) : (
            "the contact page"
          )}.
        </p>
      </div>
    </div>
  </section>
</Base>
