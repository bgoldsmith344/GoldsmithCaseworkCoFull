---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import QuoteCtaBand from "@/components/QuoteCtaBand.astro";
import { breadcrumbSchema } from "@/lib/schema";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Services | CNC Cutting & Shop Drawings | Goldsmith Casework"
  description="Radius and curved components, cabinet parts, wall paneling, duct chases, templates and jigs, and shop drawings — CNC-cut for Northern Michigan builders."
  path="/services/"
  jsonLd={[breadcrumbSchema([{ name: "Home", path: "/" }, { name: "Services", path: "/services/" }])]}
>
  <Breadcrumbs items={[{ name: "Home", path: "/" }, { name: "Services", path: "/services/" }]} />

  <section class="mx-auto max-w-6xl px-6 py-12">
    <h1 class="font-display text-h1 font-extrabold">Services</h1>
    <p class="mt-4 max-w-2xl text-lede text-ink/75">
      Every job starts the same way: send us what you have, we draft a shop drawing for your approval, then we cut. Below are the part types we cut most — if yours doesn't fit neatly into one, send it anyway.
    </p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <ServiceCard
          slug={service.id}
          title={service.data.title}
          summary={service.data.summary}
          specTag={service.data.specTag}
        />
      ))}
    </div>
  </section>

  <QuoteCtaBand />
</Base>
