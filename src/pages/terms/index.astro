---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { site } from "@/config/site";
import { breadcrumbSchema } from "@/lib/schema";

const crumbs = [{ name: "Home", path: "/" }, { name: "Terms", path: "/terms/" }];
---

<Base
  title="Terms of Use | Goldsmith Casework"
  description="Terms of use for the Goldsmith Casework website."
  path="/terms/"
  jsonLd={[breadcrumbSchema(crumbs)]}
>
  <Breadcrumbs items={crumbs} />

  <section class="mx-auto max-w-3xl px-6 py-12">
    <h1 class="font-display text-h1 font-extrabold">Terms of Use</h1>
    <p class="mt-3 font-mono text-xs text-ink/50">Last updated: placeholder — review before launch</p>

    <div class="mt-8 space-y-6 text-ink/80">
      <p>
        This page covers use of this website. It is placeholder legal copy and should be reviewed
        before the site goes live; it is not a contract for fabrication or consulting work, which is
        agreed separately per project.
      </p>

      <div>
        <h2 class="font-display text-h3 font-extrabold">Site content</h2>
        <p class="mt-2">
          Content on this site — copy, drawings, and graphics — belongs to {site.legalName ?? site.displayName}
          unless otherwise noted, and is provided for informational purposes about our services.
        </p>
      </div>

      <div>
        <h2 class="font-display text-h3 font-extrabold">Quotes</h2>
        <p class="mt-2">
          Information submitted through the quote form is a starting point for a conversation, not a
          binding order. Pricing, material, and schedule are confirmed directly before any work begins.
        </p>
      </div>

      <div>
        <h2 class="font-display text-h3 font-extrabold">No warranty on site information</h2>
        <p class="mt-2">
          We try to keep this site accurate, but capabilities, materials, and specifications are subject
          to change. Confirm project-specific details directly with us.
        </p>
      </div>
    </div>
  </section>
</Base>
