---
import Base from '../layouts/Base.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import { site, quoteForm } from '../content/site.ts';
const showPhone = site.contact.phone && !site.contact.phone.includes('000');
---
<Base
  title="Contact & Request a Quote"
  description="Request a quote for Microvellum drafting and engineering. US-based, real-time communication. Based in Petoskey, Michigan; working with shops nationwide."
>
  <section class="section">
    <div class="container contact">
      <div class="stack">
        <p class="eyebrow">{quoteForm.title}</p>
        <h1>Let's talk about your next run</h1>
        <p class="lead">{quoteForm.intro}</p>

        <ul class="contact__direct">
          <li>
            <span class="contact__ico"><Icon name="arrow" size={16} /></span>
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          </li>
          {showPhone && (
            <li>
              <span class="contact__ico"><Icon name="arrow" size={16} /></span>
              <a href={`tel:${site.contact.phone.replace(/[^0-9+]/g, '')}`}>{site.contact.phone}</a>
            </li>
          )}
        </ul>

        <div class="contact__meta">
          <p><strong>Studio:</strong> {site.contact.location}</p>
          <p><strong>Software:</strong> {site.contact.stack}</p>
        </div>

        <p class="contact__assure">
          <Icon name="check" size={18} /> {site.contact.responseTime}
        </p>
        <p class="contact__assure">
          <Icon name="check" size={18} /> {site.contact.confidentiality}
        </p>
      </div>

      <div class="card contact__formwrap">
        <QuoteForm />
      </div>
    </div>
  </section>
</Base>

<style>
  .contact {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }
  @media (min-width: 880px) {
    .contact { grid-template-columns: 1fr 1.1fr; gap: var(--space-6); }
  }
  .contact__direct {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .contact__direct li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.1rem;
  }
  .contact__ico { color: var(--brass); display: inline-flex; }
  .contact__meta {
    padding: var(--space-2) 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .contact__meta p { margin: 0.2rem 0; }
  .contact__meta strong { color: var(--ink); font-family: var(--font-head); }
  .contact__assure {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-soft);
    font-size: var(--fs-small);
  }
  .contact__assure :global(svg) { color: var(--brass-dark); flex: none; }
</style>
