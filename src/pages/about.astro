---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import WhyGoldsmith from '../components/WhyGoldsmith.astro';
import Credentials from '../components/Credentials.astro';
import CheckList from '../components/CheckList.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { about, home, site } from '../content/site.ts';
---
<Base
  title="About — US-Based Microvellum Drafting Partner"
  description={about.lead}
>
  <section class="section">
    <div class="container about__intro">
      <div class="stack">
        <p class="eyebrow">About</p>
        <h1>{about.title}</h1>
        <p class="lead">{about.lead}</p>
        {about.body.map((p) => (<p>{p}</p>))}
        <Credentials />
      </div>
      <div class="about__media">
        <Placeholder
          src="/images/brandon.svg"
          alt={`${site.owner.name}, founder of Goldsmith Casework Co.`}
          label="Photo of Brandon — swap in later"
          ratio="3 / 4"
        />
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="container">
      <p class="eyebrow">Why Goldsmith</p>
      <h2>What sets the work apart</h2>
      <div style="margin-top: var(--space-4)"><WhyGoldsmith /></div>
    </div>
  </section>

  <section class="section section--wood">
    <div class="container">
      <p class="eyebrow">{home.checklist.title}</p>
      <h2>What you can expect</h2>
      <div style="margin-top: var(--space-4)"><CheckList items={home.checklist.items} /></div>
    </div>
  </section>

  <ContactCTA
    title="Let's talk about your next run."
    label="Request a Quote"
    href="/contact"
  />
</Base>

<style>
  .about__intro {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }
  @media (min-width: 880px) {
    .about__intro { grid-template-columns: 1.4fr 1fr; gap: var(--space-6); }
  }
</style>
