---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import QuoteCtaBand from "@/components/QuoteCtaBand.astro";
import { site } from "@/config/site";
import { breadcrumbSchema } from "@/lib/schema";

const crumbs = [{ name: "Home", path: "/" }, { name: "About", path: "/about/" }];
---

<Base
  title="About | Goldsmith's Casework — Petoskey, MI"
  description="Goldsmith's Casework is a CNC fabrication and shop-drawing service in Petoskey, Michigan. The drafting is the moat — the machine just executes it."
  path="/about/"
  jsonLd={[breadcrumbSchema(crumbs)]}
>
  <Breadcrumbs items={crumbs} />

  <section class="mx-auto max-w-3xl px-6 py-12">
    <h1 class="font-display text-h1 font-extrabold">About Goldsmith's Casework</h1>

    <div class="mt-6 space-y-5 text-lede text-ink/80 leading-relaxed">
      <p>
        Owning a CNC router isn't the hard part anymore — plenty of shops have one. The hard part is reading an architect's print, understanding what a builder actually needs on site, and turning that into cut geometry a machine can run without guessing. That translation is the job here.
      </p>
      <p>
        Goldsmith's Casework is run by Brandon Goldsmith out of {site.address.city}, {site.address.state}. Every job — a radius arch rafter, a run of cabinet parts, a duct chase built to fit a beam nobody measured twice — starts as a drawing, gets approved as a drawing, and only then goes to the machine. That order matters: it's the step that catches a mistake before it's cut into a $200 sheet of material instead of after.
      </p>
      <p>
        Locally, that means fabrication: send a print or a sketch, get parts back that drop into place. Nationally, it means consulting with other shops on Microvellum, Fusion 360 CAM, and CNC workflow — the same drafting and programming discipline, applied to someone else's machine instead of ours.
      </p>
    </div>

    <div class="mt-10 border border-ink/15 p-6">
      <p class="spec-tag">Working software</p>
      <p class="mt-2 font-mono text-sm">Microvellum / Toolbox · Fusion 360 · AutoCAD · BricsCAD</p>
    </div>
  </section>

  <QuoteCtaBand />
</Base>
