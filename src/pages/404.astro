---
import Base from "@/layouts/Base.astro";
import Button from "@/components/Button.astro";
---

<Base
  title="Page Not Found | Goldsmith Casework"
  description="The page you're looking for doesn't exist."
  path="/404/"
>
  <section class="mx-auto flex max-w-2xl flex-col items-start gap-4 px-6 py-24">
    <span class="spec-tag">404</span>
    <h1 class="font-display text-h1 font-extrabold">Page not found</h1>
    <p class="text-lede text-ink/75">
      That page doesn't exist, or it's moved. Try the homepage, or jump straight to a quote.
    </p>
    <div class="mt-4 flex flex-col gap-3 sm:flex-row">
      <Button href="/" variant="secondary">Back to homepage</Button>
      <Button href="/quote/" variant="primary">Request a quote</Button>
    </div>
  </section>
</Base>
