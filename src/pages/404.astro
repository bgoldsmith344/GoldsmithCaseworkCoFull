---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---
<Base title="Page not found" description="The page you were looking for doesn't exist.">
  <section class="section">
    <div class="container narrow stack" style="text-align:center; display:grid; justify-items:center;">
      <p class="eyebrow">404</p>
      <h1>We couldn't find that page</h1>
      <p class="lead">The page may have moved. Let's get you back on track.</p>
      <Button href="/" variant="primary">Back to home</Button>
    </div>
  </section>
</Base>
